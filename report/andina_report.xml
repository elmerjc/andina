<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="report.paperformat" id="paperformat_andina_report">
        <field name="name">Formato de Andina</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_right">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record model="report.paperformat" id="paperformat_andina_report_landscape">
        <field name="name">Formato de Andina</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_right">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_cantidades_action" model="ir.actions.report">
        <field name="name">Detalle de factura</field>
        <field name="model">andina.report.cantidades</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">andina.andina_report_cantidades_view</field>
        <field name="report_file">andina.andina_report_cantidades_view</field>
        <field name="print_report_name">'Reporte detallado %s' % (object.date_inicio)</field>
        <field name="paperformat_id" ref="paperformat_andina_report"/>
    </record>

    <record id="report_consolidado_action" model="ir.actions.report">
        <field name="name">Reporte consolidado</field>
        <field name="model">andina.report.consolidado</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">andina.andina_report_consolidado_view</field>
        <field name="report_file">andina.andina_report_consolidado_view</field>
        <field name="print_report_name">'Reporte consolidado %s' % (object.fecha_inicio)</field>
        <field name="paperformat_id" ref="paperformat_andina_report"/>
    </record>

    <record id="report_gerencia_action" model="ir.actions.report">
        <field name="name">Reporte por gerencia</field>
        <field name="model">andina.report.gerencia</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">andina.andina_report_gerencia_view</field>
        <field name="report_file">andina.andina_report_gerencia_view</field>
        <field name="print_report_name">'Reporte por Gerencia %s' % (object.turno)</field>
        <field name="paperformat_id" ref="paperformat_andina_report"/>
    </record>

    <record id="report_area_action" model="ir.actions.report">
        <field name="name">Reporte por area</field>
        <field name="model">andina.report.area</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">andina.andina_report_area_view</field>
        <field name="report_file">andina.andina_report_area_view</field>
        <field name="print_report_name">'Reporte por Area %s' % (object.fecha_inicio)</field>
        <field name="paperformat_id" ref="paperformat_andina_report"/>
    </record>
</odoo>