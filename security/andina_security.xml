<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="modulo_andina_lavado_industrial" model="ir.module.category">
        <field name="name">Andina Lavado Industrial</field> 
        <field name="sequence">7</field>
    </record>

    <record id="group_andina_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="modulo_andina_lavado_industrial"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_andina_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="modulo_andina_lavado_industrial"/>
        <field name="implied_ids" eval="[(4, ref('group_andina_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>
</data>
</odoo>